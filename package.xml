<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>duatic_ethercat_interface</name>
  <version>1.0.0</version>
  <description>An interface wrapper around ethercat master implementations</description>
  <maintainer email="lnachtigall@duatic.com">Lennart Nachtigall</maintainer>
  <license>BSD 3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <!-- Note at the moment only SOEM is supported-->
  <depend>soem_vendor</depend>
  <!--<depend>etherlab_master_vendor</depend>-->

  <depend>duatic_message_logger</depend>

  <!--Tooling dependencies-->
  <depend>libcxxopts-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
